---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { slugify, canonical } from '../../lib/players';
export async function getStaticPaths() {
  const seasons = await getCollection('seasons');
  return seasons.map((s) => ({ params: { year: String(s.data.year) }, props: { season: s } }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { season } = Astro.props;
const d = season.data;
const { Content } = await render(season);
---
<Base title={`${d.year} season`}>
  <h1>{d.year} season</h1>
  <p class="lede">{[d.league, d.division].filter(Boolean).join(' · ')}{d.finish && ` — ${d.finish}`}{d.record && ` (${d.record})`}</p>
  {d.placeholder && <div class="banner">Sample data — not real results yet.</div>}
  <Content />
  {d.captains.length > 0 && <p><b>Captains:</b> {d.captains.map(canonical).join(', ')}</p>}
  {d.coaches.length > 0 && <p><b>Coaches:</b> {d.coaches.join(', ')}</p>}
  {d.gm && <p><b>General manager:</b> {d.gm}</p>}
  {d.games.length > 0 && (
    <>
      <h2>Results</h2>
      <table>
        <thead><tr><th>Date</th><th>Opponent</th><th></th><th>Score</th><th>Note</th></tr></thead>
        <tbody>
          {d.games.map((g) => (
            <tr><td>{g.date ?? ''}</td><td>{g.opponent}</td><td class={g.result}>{g.result}</td><td>{g.score}</td><td>{g.note ?? ''}</td></tr>
          ))}
        </tbody>
      </table>
    </>
  )}
  {d.roster.length > 0 && (
    <>
      <h2>Roster</h2>
      <ul class="tags">
        {d.roster.map((n) => <li><a href={`${base}/players/${slugify(canonical(n))}`}>{canonical(n)}</a>{d.rosterNotes[n] && <small> · {d.rosterNotes[n]}</small>}</li>)}
      </ul>
    </>
  )}
  {d.practiceRoster.length > 0 && (
    <>
      <h2>Practice roster</h2>
      <ul class="tags">{d.practiceRoster.map((n) => <li>{n}</li>)}</ul>
    </>
  )}
  {d.sources.length > 0 && <p class="lede">Sources: {d.sources.join('; ')}</p>}
</Base>
