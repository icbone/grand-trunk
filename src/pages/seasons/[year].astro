---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { slugify, canonical } from '../../lib/players';
import { medal } from '../../lib/medals';
export async function getStaticPaths() {
  const seasons = await getCollection('seasons');
  return seasons.map((s) => ({ params: { year: String(s.data.year) }, props: { season: s } }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { season } = Astro.props;
const d = season.data;
const { Content } = await render(season);
const link = (n: string) => `${base}/players/${slugify(canonical(n))}`;
const hasFacts = Boolean(d.league || d.division || d.record || d.gm || d.captains.length || d.coaches.length || d.awards.length || d.roster.length);
---
<Base title={`${d.year} season`}>
  <section class="hero">
    <p class="eyebrow"><a href={`${base}/seasons`}>← All seasons</a></p>
    <h1>{d.year} season {d.honour && <span role="img" aria-label={medal[d.honour].label}>{medal[d.honour].emoji}</span>}</h1>
    {d.finish && <p class="lede">{d.finish}</p>}
  </section>
  {hasFacts && (
  <dl class="facts card">
    {d.league && <><dt>League</dt><dd>{d.league}</dd></>}
    {d.division && <><dt>Division</dt><dd>{d.division}</dd></>}
    {d.record && <><dt>Record</dt><dd>{d.record}</dd></>}
    {d.captains.length > 0 && <><dt>Captains</dt><dd>{d.captains.map((c, i) => <>{i > 0 && ', '}<a href={link(c)}>{canonical(c)}</a></>)}</dd></>}
    {d.coaches.length > 0 && <><dt>Coaches</dt><dd>{d.coaches.map((c, i) => <>{i > 0 && ', '}<a href={link(c)}>{canonical(c)}</a></>)}</dd></>}
    {d.awards.length > 0 && <><dt>Awards</dt><dd>{d.awards.map((a, i) => <>{i > 0 && '; '}{a.award}: <a href={link(a.name)}>{canonical(a.name)}</a></>)}</dd></>}
    {d.gm && <><dt>General manager</dt><dd>{canonical(d.gm)}</dd></>}
    {d.roster.length > 0 && <><dt>Roster size</dt><dd>{d.roster.length} players</dd></>}
  </dl>
  )}
  <div class="prose"><Content /></div>
  {d.highlights.length > 0 && (
    <>
      <h2>Highlights</h2>
      <ul class="plain highlights">
        {d.highlights.map((h) => <li class="card"><a href={link(h.name)}>{canonical(h.name)}</a>: {h.text}</li>)}
      </ul>
    </>
  )}
  {d.games.length > 0 && (
    <>
      <h2>Results</h2>
      <table>
        <caption class="sr-only">{d.year} game results</caption>
        <thead><tr><th scope="col">Date</th><th scope="col">Opponent</th><th scope="col">Result</th><th scope="col">Score</th><th scope="col">Note</th></tr></thead>
        <tbody>
          {d.games.map((g) => (
            <tr><td>{g.date ?? ''}</td><td>{g.opponent}</td><td class={g.result}>{g.result}</td><td>{g.score}</td><td>{g.note ?? ''}</td></tr>
          ))}
        </tbody>
      </table>
    </>
  )}
  {d.roster.length > 0 && (
    <>
      <h2>Roster</h2>
      <ul class="tags">
        {d.roster.map((n) => <li><a href={link(n)}>{canonical(n)}</a>{d.rosterNotes[n] && <small> · {d.rosterNotes[n]}</small>}</li>)}
      </ul>
    </>
  )}
  {d.sources.length > 0 && (
    <p class="sources">Sources: {d.sources.map((src, i) => <>{i > 0 && '; '}{typeof src === 'string' ? src : <a href={src.url}>{src.label}</a>}</>)}</p>
  )}
</Base>
