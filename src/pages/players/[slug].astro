---
import Base from '../../layouts/Base.astro';
import { getPeople } from '../../lib/players';
export async function getStaticPaths() {
  return (await getPeople()).map((p) => ({ params: { slug: p.slug }, props: { player: p } }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { player } = Astro.props;
const n = (k: number, w: string) => `${k} ${w}${k === 1 ? '' : 's'}`;
const summary = [
  player.years.length && `${n(player.years.length, 'season')} played`,
  player.coachYears.length && `${n(player.coachYears.length, 'season')} coached`,
].filter(Boolean).join(' · ');
---
<Base title={player.name}>
  <h1>{player.name}</h1>
  <p class="lede">{summary} with Grand Trunk</p>
  {player.years.length > 0 && (
    <>
      <h2>Played</h2>
      <ul class="tags">
        {player.years.map((y) => <li><a href={`${base}/seasons/${y}`}>{y}</a>{player.captain.includes(y) && ' (C)'}</li>)}
      </ul>
    </>
  )}
  {player.coachYears.length > 0 && (
    <>
      <h2>Coached</h2>
      <ul class="tags">
        {player.coachYears.map((y) => <li><a href={`${base}/seasons/${y}`}>{y}</a></li>)}
      </ul>
    </>
  )}
</Base>
