---
import Base from '../../layouts/Base.astro';
import { getPlayers } from '../../lib/players';
export async function getStaticPaths() {
  return (await getPlayers()).map((p) => ({ params: { slug: p.slug }, props: { player: p } }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { player } = Astro.props;
---
<Base title={player.name}>
  <h1>{player.name}</h1>
  <p class="lede">{player.years.length} season{player.years.length === 1 ? '' : 's'} with Grand Trunk</p>
  <ul class="tags">
    {player.years.map((y) => <li><a href={`${base}/seasons/${y}`}>{y}</a>{player.captain.includes(y) && ' (C)'}</li>)}
  </ul>
</Base>
