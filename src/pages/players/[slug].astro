---
import Base from '../../layouts/Base.astro';
import { getPeople } from '../../lib/players';
export async function getStaticPaths() {
  return (await getPeople()).map((p) => ({ params: { slug: p.slug }, props: { player: p } }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { player } = Astro.props;
const n = (k: number, w: string) => `${k} ${w}${k === 1 ? '' : 's'}`;
const summary = [
  player.years.length && `${n(player.years.length, 'season')} played`,
  player.coachYears.length && `${n(player.coachYears.length, 'season')} coached`,
].filter(Boolean).join(' · ');
---
<Base title={player.name}>
  <section class="hero">
    <p class="eyebrow"><a href={`${base}/players`}>← All players</a></p>
    <h1>{player.name}</h1>
    <p class="lede">{summary} with Grand Trunk</p>
  </section>
  {player.awards.length > 0 && (
    <>
      <h2>Awards</h2>
      <ul class="plain">
        {player.awards.map((a) => <li><span role="img" aria-label="Award">🏆</span> {a.award}, <a href={`${base}/seasons/${a.year}`}>{a.year}</a></li>)}
      </ul>
    </>
  )}
  {player.highlights.length > 0 && (
    <>
      <h2>Highlights</h2>
      <ul class="plain highlights">
        {player.highlights.map((h) => <li class="card"><a href={`${base}/seasons/${h.year}`}>{h.year}</a>: {h.text}</li>)}
      </ul>
    </>
  )}
  {player.years.length > 0 && (
    <>
      <h2>Played</h2>
      <ul class="tags">
        {player.years.map((y) => <li><a href={`${base}/seasons/${y}`}>{y}</a>{player.captain.includes(y) && ' (C)'}</li>)}
      </ul>
    </>
  )}
  {player.coachYears.length > 0 && (
    <>
      <h2>Coached</h2>
      <ul class="tags">
        {player.coachYears.map((y) => <li><a href={`${base}/seasons/${y}`}>{y}</a></li>)}
      </ul>
    </>
  )}
</Base>
