---
import Base from '../layouts/Base.astro';
import { getCoaches } from '../lib/players';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const coaches = await getCoaches();
---
<Base title="Coaches">
  <section class="hero">
    <p class="eyebrow">{coaches.length} coaches on file</p>
    <h1>Coaches</h1>
    <p class="lede">Everyone who has coached Grand Trunk, with the seasons they coached.</p>
  </section>
  <table>
    <caption class="sr-only">Grand Trunk coaches</caption>
    <thead><tr><th scope="col">Coach</th><th scope="col">Seasons coached</th><th scope="col">Years</th><th scope="col">Also played</th></tr></thead>
    <tbody>
      {coaches.map((c) => (
        <tr>
          <td><a href={`${base}/players/${c.slug}`}>{c.name}</a></td>
          <td>{c.coachYears.length}</td>
          <td>{c.coachYears.join(', ')}</td>
          <td>{c.years.length ? `${c.years.length} seasons` : '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
