---
import '../styles/global.css';
interface Props { title?: string }
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const full = title ? `${title} · Grand Trunk` : 'Grand Trunk Ultimate — Toronto, since 2004';
const nav = [
  ['Seasons', '/seasons'],
  ['Players', '/players'],
  ['Coaches', '/coaches'],
  ['Lore', '/lore'],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{full}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href={`${base}/`}>Grand Trunk</a>
        <nav aria-label="Main">
          <ul>
            {nav.map(([label, href]) => {
              const path = `${base}${href}`;
              const current = Astro.url.pathname.replace(/\/$/, '').startsWith(path);
              return <li><a href={path} aria-current={current ? 'page' : undefined}>{label}</a></li>;
            })}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      Grand Trunk · Toronto open club ultimate · est. 2004
    </footer>
  </body>
</html>
